# Copy to .env.local and fill in. Never commit .env.local.

# --- App ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
# live | mock. In mock mode notifications are logged, not sent.
NOTIFY_MODE=mock

# --- Supabase: auth (phone OTP) and photo storage only; the database is Neon ---
# Dashboard > Settings > API Keys. New-style keys are the ones to use:
#   Project URL                        -> NEXT_PUBLIC_SUPABASE_URL
#   Publishable key (sb_publishable_…) -> NEXT_PUBLIC_SUPABASE_ANON_KEY   (legacy name: anon)
#   Secret key      (sb_secret_…)      -> SUPABASE_SERVICE_ROLE_KEY       (legacy name: service_role; server only)
# The JWKS URL is not needed. Local `supabase start` prints equivalent values.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-me
SUPABASE_SERVICE_ROLE_KEY=replace-me
# Direct Postgres connection for Drizzle migrations and seed
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# --- Secrets shared with scheduled jobs and providers ---
CRON_SECRET=replace-me-with-32-random-bytes

# --- Razorpay (test mode locally) ---
RAZORPAY_KEY_ID=rzp_test_replace
RAZORPAY_KEY_SECRET=replace-me
RAZORPAY_WEBHOOK_SECRET=replace-me

# --- Notifications ---
INTERAKT_API_KEY=replace-me
INTERAKT_WEBHOOK_SECRET=replace-me
MSG91_AUTH_KEY=replace-me
MSG91_SENDER_ID=BKRRDS

# --- Catalogue ---
GOOGLE_BOOKS_API_KEY=

# --- Observability (optional locally) ---
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
